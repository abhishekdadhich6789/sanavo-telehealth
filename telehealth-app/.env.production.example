# Production environment for Sanavo (sanavo.in)
# Copy to .env.production and fill secrets before deploy

NODE_ENV=production
DATABASE_URL="file:/app/data/sanavo.db"

# REQUIRED — paste long random values (see DEPLOY.md)
JWT_SECRET=
PASSWORD_PEPPER=

NEXT_PUBLIC_APP_URL=https://sanavo.in

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM="Sanavo <noreply@sanavo.in>"

# SMS (India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SANAVO
# MSG91_TEMPLATE_ID=
