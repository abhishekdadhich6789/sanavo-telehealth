# Database
DATABASE_URL="file:./dev.db"

# Session security (change in production)
JWT_SECRET=your-random-secret-string-at-least-32-chars

# Extra secret mixed into password hashing (recommended in production)
# Use a long random string different from JWT_SECRET
PASSWORD_PEPPER=your-random-password-pepper

# Public app URL used in SMS/email status links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: force demo payments in local (never works in production)
# PAYMENT_DEMO_MODE=true
# Webhook secret from Razorpay Dashboard → Webhooks
# RAZORPAY_WEBHOOK_SECRET=

# --- Messaging (certificate + slot delivery) ---

# Email option A: Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="Sanavo <onboarding@resend.dev>"

# Email option B: SMTP (Gmail / Outlook / custom)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="Sanavo <your@gmail.com>"

# SMS option A: MSG91 (India) — https://msg91.com
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SANAVO
# MSG91_TEMPLATE_ID=

# SMS option B: Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
