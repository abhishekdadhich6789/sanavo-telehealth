generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String
  role               String
  name               String
  nmcNumber          String?          @unique
  phone              String?
  active             Boolean          @default(true)
  mustChangePassword Boolean          @default(false)
  createdAt          DateTime         @default(now())
  createdBy          String?
  assignedRequests   ConsultRequest[] @relation("AssignedDoctor")
}

model ConsultRequest {
  id                 String          @id @default(uuid())
  type               String
  status             String          @default("pending")
  patientJson        String
  medicalCertificate String?
  telehealth         String?
  paymentJson        String?
  doctorNotes        String?
  approvedDays       Int?
  declineReason      String?
  certificateJson    String?
  slotJson           String?
  assignedDoctorId   String?
  assignedDoctor     User?           @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])
  accessToken        String          @unique @default(uuid())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  statusHistory      StatusHistory[]
  notifications      Notification[]
  paymentOrder       PaymentOrder?

  @@index([type, status])
  @@index([assignedDoctorId, status])
  @@index([status, createdAt])
}

model PaymentOrder {
  id           String          @id @default(uuid())
  orderId      String          @unique
  paymentId    String?         @unique
  serviceType  String
  amount       Int
  currency     String          @default("INR")
  status       String          @default("created")
  patientEmail String?
  patientPhone String?
  patientName  String?
  requestId    String?         @unique
  request      ConsultRequest? @relation(fields: [requestId], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
}

model StatusHistory {
  id         String         @id @default(uuid())
  requestId  String
  request    ConsultRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  actorId    String?
  actorRole  String?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([requestId, createdAt])
}

model Notification {
  id        String         @id @default(uuid())
  requestId String
  request   ConsultRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  channel   String
  recipient String
  subject   String?
  body      String
  status    String         @default("queued")
  createdAt DateTime       @default(now())

  @@index([requestId, createdAt])
}
