# Paste these into Railway → Variables (all required unless marked optional)

NODE_ENV=production
PORT=3000

# REQUIRED secrets (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
PASSWORD_PEPPER=REPLACE_WITH_ANOTHER_OPENSSL_RAND_HEX_32

# REQUIRED — must match Railway Volume mount path
DATABASE_URL=file:/data/sanavo.db
NEXT_PUBLIC_APP_URL=https://sanavo.in

# Email (optional until you configure Resend)
EMAIL_FROM=Sanavo <noreply@sanavo.in>
# RESEND_API_KEY=

# Payments (optional in demo; set for real charges)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# SMS (optional)
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=SANAVO
